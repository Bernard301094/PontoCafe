<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      O Ponto Café é sempre claro, mesmo com o aparelho no tema escuro.

      O Compose já fixa o esquema claro (ver PontoCafeTheme), mas isso sozinho
      não basta: a janela do Android continua sendo pintada pelo tema da
      Activity antes do primeiro frame, e a partir do Android 10 o sistema pode
      aplicar "force dark" por cima de um tema claro. Este tema fecha as duas
      portas — fundo no canvas do design e force-dark desligado.
    -->
    <style name="Theme.PontoCafe" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ponto_surface</item>
        <!-- Ignorado abaixo do Android 10; nesses aparelhos não existe force dark. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
