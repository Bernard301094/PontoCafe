# Backend Ponto Café — ambiente local / Cloudflare Workers
# Nunca coloque credenciais reais neste arquivo nem no GitHub.
# Em Cloudflare, DATABASE_URL e as chaves abaixo devem ser cadastradas como Secrets.

DATABASE_URL=postgresql://usuario:senha@host:5432/pontocafe?sslmode=require
BETTER_AUTH_SECRET=gere-um-segredo-longo-e-aleatorio
BETTER_AUTH_URL=https://ponto-cafe-api.seu-subdominio.workers.dev
CODE_PEPPER=gere-outro-segredo-longo-e-aleatorio
BIOMETRIC_MASTER_KEY=base64-de-32-bytes-aleatorios
FIRST_ADMIN_SETUP_KEY=chave-temporaria-de-instalacao-com-pelo-menos-16-caracteres
APP_TIMEZONE=America/Fortaleza

# Sessão de acesso permanece válida por até 7 dias; o APK reautentica localmente
# com biometria/PIN do dispositivo ao voltar para áreas restritas.
SESSION_TTL_HOURS=168

# Reconhecimento facial. Ajuste somente após calibração com dados reais.
# Estes valores correspondem à política efetiva da candidata 1.0.
FACE_MATCH_THRESHOLD=0.72
FACE_IDENTIFICATION_MARGIN=0.06
FACE_ENROLLMENT_DUPLICATE_THRESHOLD=0.78
AUTHORIZATION_TTL_SECONDS=600
FACE_VERIFICATION_TTL_SECONDS=180

# Continuidade offline.
# O Worker rejeita eventos offline mais antigos do que esta janela.
OFFLINE_MAX_EVENT_AGE_HOURS=24

# Governança biométrica: templates de colaboradores já desativados podem ser
# eliminados após esta quantidade de dias.
BIOMETRIC_RETENTION_DAYS=90

# Diários técnicos que não precisam crescer indefinidamente.
# Operações idempotentes antigas permanecem 30 dias, muito além da janela normal
# de retry/reconciliação, e telemetria APP_HEALTH também é limitada a 30 dias.
PONTO_OPERATION_RETENTION_DAYS=30
DEVICE_HEALTH_RETENTION_DAYS=30

# Replay curto e cifrado para cadastro idempotente de dispositivos.
DEVICE_REGISTRATION_IDEMPOTENCY_TTL_SECONDS=600

# Controle de versão do APK. Antes de liberar 1.0 em produção, confirme que a
# migração 007 e o Worker compatível já foram implantados.
APP_LATEST_ANDROID_VERSION=1.0.0
APP_MIN_ANDROID_VERSION=0.15.0
# BACKEND_REVISION é injetado automaticamente pelo script de deploy Cloudflare.

# REGRA OPERACIONAL IMPORTANTE:
# O tempo padrão atual de café é 15 minutos = 900 segundos.
# A duração é armazenada na tabela regras_cafe, não como segredo/variável de ambiente.
