{
  "name": "pontocafe-api",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx src/local.ts",
    "start": "tsx src/local.ts",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run typecheck && wrangler deploy",
    "preview": "npm run typecheck && wrangler versions upload",
    "deploy:dry": "npm run typecheck && wrangler deploy --dry-run",
    "cf:types": "wrangler types",
    "auth:migrate": "tsx src/migrate-auth.ts",
    "auth:bootstrap": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "better-auth": "1.6.25",
    "hono": "4.12.32",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "^4.116.0"
  }
}
