{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pontocafe",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_TIMEZONE": "America/Fortaleza",
    "SESSION_TTL_HOURS": "12",
    "FACE_MATCH_THRESHOLD": "0.72",
    "FACE_IDENTIFICATION_MARGIN": "0.06",
    "AUTHORIZATION_TTL_SECONDS": "180",
    "FACE_VERIFICATION_TTL_SECONDS": "180"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "270792708424473aa5859f5bf607f758"
    }
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "CODE_PEPPER",
      "BIOMETRIC_MASTER_KEY",
      "FIRST_ADMIN_SETUP_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
