{
  "$schema": "backend/node_modules/wrangler/config-schema.json",
  "name": "pontocafe",
  "main": "backend/src/cloudflare.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "APP_TIMEZONE": "America/Fortaleza",
    "SESSION_TTL_HOURS": "168",
    "FACE_MATCH_THRESHOLD": "0.72",
    "FACE_IDENTIFICATION_MARGIN": "0.06",
    "FACE_ENROLLMENT_DUPLICATE_THRESHOLD": "0.78",
    "AUTHORIZATION_TTL_SECONDS": "600",
    "FACE_VERIFICATION_TTL_SECONDS": "180",
    "OFFLINE_MAX_EVENT_AGE_HOURS": "24",
    "BIOMETRIC_RETENTION_DAYS": "90",
    "DEVICE_REGISTRATION_IDEMPOTENCY_TTL_SECONDS": "600",
    "APP_LATEST_ANDROID_VERSION": "0.7.0",
    "APP_MIN_ANDROID_VERSION": "0.4.0"
  },
  "triggers": {
    "crons": ["15 3 * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "270792708424473aa5859f5bf607f758"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "pontocafe-avatars"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}